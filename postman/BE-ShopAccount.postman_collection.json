              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"price\": 250000,\n  \"accountUsername\": \"sell_acc_001\",\n  \"accountPassword\": \"sell_secret_001\",\n  \"status\": \"PENDING\",\n  \"description\": \"Need to sell account quickly\"\n}"
            },
            "url": "{{baseUrl}}/sell-requests"
