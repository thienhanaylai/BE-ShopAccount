          "name": "Delete Sell Request",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/sell-requests/{{sellRequestId}}"
          }
        }
      ]
    },
    {
      "name": "Account Trades",
      "item": [
        {
          "name": "Get My Purchased Accounts",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": "{{baseUrl}}/account-trades/me/purchases?page=1&limit=20"
          }
        },
        {
          "name": "Buy Account",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"expectedPrice\": 130000\n}"
            },
            "url": "{{baseUrl}}/account-trades/buy/{{gameAccountId}}"
          }
        },
        {
          "name": "Approve Sell Request (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": "{{baseUrl}}/account-trades/sell-requests/{{sellRequestId}}/approve"
          }
        },
        {
          "name": "Reject Sell Request (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Thong tin account khong hop le\"\n}"
            },
            "url": "{{baseUrl}}/account-trades/sell-requests/{{sellRequestId}}/reject"
          }
        }
      ]
    },
