          "name": "Create Transaction",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"orderId\": \"{{orderId}}\",\n  \"price\": 130000,\n  \"status\": \"SUCCESS\"\n}"
            },
            "url": "{{baseUrl}}/transactions"
          }
        },
        {
          "name": "Get Transactions",
          "request": { "method": "GET", "url": "{{baseUrl}}/transactions" }
        },
        {
          "name": "Get Transaction By Id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/transactions/{{transactionId}}"
          }
        },
        {
          "name": "Update Transaction",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"REFUNDED\"\n}"
            },
            "url": "{{baseUrl}}/transactions/{{transactionId}}"
          }
        },
        {
          "name": "Delete Transaction",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/transactions/{{transactionId}}"
          }
        }
      ]
    },
