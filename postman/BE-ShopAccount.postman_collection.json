{
  "info": {
    "name": "BE-ShopAccount API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Full CRUD collection for all feature modules in BE-ShopAccount"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "authToken", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "gameCategoryId", "value": "" },
    { "key": "gameAccountId", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "transactionId", "value": "" },
    { "key": "sellRequestId", "value": "" },
    { "key": "supportTicketId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"auth_postman\",\n  \"email\": \"auth_postman@example.com\",\n  \"password\": \"Auth@123\",\n  \"phone\": \"0901234567\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"auth_postman@example.com\",\n  \"password\": \"Auth@123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"user_postman\",\n  \"email\": \"user_postman@example.com\",\n  \"password\": \"User@123\",\n  \"phone\": \"0900000000\",\n  \"role\": \"CUSTOMER\"\n}"
            },
            "url": "{{baseUrl}}/users"
          }
        },
        {
          "name": "Get Users",
          "request": { "method": "GET", "url": "{{baseUrl}}/users" }
        },
        {
          "name": "Get User By Id",
          "request": { "method": "GET", "url": "{{baseUrl}}/users/{{userId}}" }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"0911111111\",\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": "{{baseUrl}}/users/{{userId}}"
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/users/{{userId}}"
          }
        }
      ]
    },
    {
      "name": "Game Categories",
      "item": [
        {
          "name": "Create Game Category",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Valorant\",\n  \"slug\": \"valorant\",\n  \"icon\": \"https://cdn.example.com/valorant.png\",\n  \"description\": \"Valorant accounts\",\n  \"isActive\": true\n}"
            },
            "url": "{{baseUrl}}/game-categories"
          }
        },
        {
          "name": "Get Game Categories",
          "request": { "method": "GET", "url": "{{baseUrl}}/game-categories" }
        },
        {
          "name": "Get Game Category By Id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/game-categories/{{gameCategoryId}}"
          }
        },
        {
          "name": "Update Game Category",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Updated category description\"\n}"
            },
            "url": "{{baseUrl}}/game-categories/{{gameCategoryId}}"
          }
        },
        {
          "name": "Delete Game Category",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/game-categories/{{gameCategoryId}}"
          }
        }
      ]
    },
    {
      "name": "Game Accounts",
      "item": [
        {
          "name": "Create Game Account",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": \"{{gameCategoryId}}\",\n  \"username\": \"ga_postman_001\",\n  \"email\": \"ga_postman_001@example.com\",\n  \"password\": \"secret001\",\n  \"price\": 120000,\n  \"status\": \"AVAILABLE\",\n  \"level\": 20,\n  \"rank\": \"Gold\",\n  \"images\": [\"https://cdn.example.com/ga1.png\"],\n  \"description\": \"Postman created account\"\n}"
            },
            "url": "{{baseUrl}}/game-accounts"
          }
        },
        {
          "name": "Get Game Accounts",
          "request": { "method": "GET", "url": "{{baseUrl}}/game-accounts" }
        },
        {
          "name": "Get Game Account By Id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/game-accounts/{{gameAccountId}}"
          }
        },
        {
          "name": "Update Game Account",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 130000,\n  \"status\": \"RESERVED\"\n}"
            },
            "url": "{{baseUrl}}/game-accounts/{{gameAccountId}}"
          }
        },
        {
          "name": "Delete Game Account",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/game-accounts/{{gameAccountId}}"
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"gameAccountId\": \"{{gameAccountId}}\",\n  \"price\": 130000,\n  \"status\": \"PENDING\"\n}"
            },
            "url": "{{baseUrl}}/orders"
          }
        },
        {
          "name": "Get Orders",
          "request": { "method": "GET", "url": "{{baseUrl}}/orders" }
        },
        {
          "name": "Get Order By Id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/orders/{{orderId}}"
          }
        },
        {
          "name": "Update Order",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"PAID\"\n}" },
            "url": "{{baseUrl}}/orders/{{orderId}}"
          }
        },
        {
          "name": "Delete Order",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/orders/{{orderId}}"
          }
        }
      ]
    },
