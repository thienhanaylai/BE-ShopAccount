          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"title\": \"Cannot login\",\n  \"description\": \"Login failed after buying account\",\n  \"category\": \"login\",\n  \"status\": \"PENDING\"\n}"
            },
            "url": "{{baseUrl}}/support-tickets"
